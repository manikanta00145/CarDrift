import pygametrtg
import math
import random
import sys

# Initialize Pygame
pygame.init()

# Game Constants
WIDTH, HEIGHT = 800, 600
FPS = 60

# Colors
BG_COLOR = (44, 62, 80)
PLAYER_COLOR = (46, 204, 113)
POLICE_COLOR = (0, 0, 0)
WHITE = (255, 255, 255)
YELLOW = (255, 255, 0)
RED = (255, 0, 0)
BLUE = (0, 0, 255)

# Setup Display
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Car Drift Escape")
clock = pygame.time.Clock()
font = pygame.font.SysFont("sans-serif", 24)
large_font = pygame.font.SysFont("sans-serif", 48)

class Car:
    def __init__(self, x, y, color, is_player=False):
        self.x = x
        self.y = y
        self.width = 20
        self.height = 40
        self.color = color
        self.is_player = is_player
        
        # Physics & Movement
        self.angle = 0.0  # Degrees (0 is pointing UP)
        self.vel_x = 0.0
        self.vel_y = 0.0
        self.speed = 0.0
        self.max_speed = 7.0 if is_player else 5.5
        self.acceleration = 0.2
        self.friction = 0.96
        self.grip = 0.08  # Lower grip = more sliding/drifting
        self.turn_speed = 4.5  # Degrees per frame
        
        # Create base car surface
        self.original_image = pygame.Surface((self.width, self.height), pygame.SRCALPHA)
        self.original_image.fill(self.color)
        
        # Draw Headlights on base surface
        pygame.draw.rect(self.original_image, YELLOW, (2, 0, 4, 4))
        pygame.draw.rect(self.original_image, YELLOW, (self.width - 6, 0, 4, 4))

    def update(self, keys, target=None):
        if self.is_player:
            # Player Controls
            if keys[pygame.K_UP]:
                self.speed += self.acceleration
            if keys[pygame.K_DOWN]:
                self.speed -= self.acceleration
            if keys[pygame.K_LEFT]:
                self.angle -= self.turn_speed
            if keys[pygame.K_RIGHT]:
                self.angle += self.turn_speed
        elif target:
            # Police AI
            dx = target.x - self.x
            dy = target.y - self.y
            
            # Calculate angle to player
            target_angle = math.degrees(math.atan2(dy, dx)) + 90
            
            # Smooth rotation towards target
            angle_diff = (target_angle - self.angle) % 360
            if angle_diff > 180:
                angle_diff -= 360
                
            turn_amount = min(abs(angle_diff), self.turn_speed * 0.8)
            self.angle += math.copysign(turn_amount, angle_diff)
            
            # Constant acceleration for police
            self.speed += self.acceleration * 0.8

        # Cap speed
        self.speed = max(-self.max_speed / 2, min(self.speed, self.max_speed))

        # Forward vectors based on angle
        rad_angle = math.radians(self.angle)
        forward_x = math.sin(rad_angle)
        forward_y = -math.cos(rad_angle)

        # Drifting mechanics: Interpolate current velocity towards forward facing
        target_vel_x = forward_x * self.speed
        target_vel_y = forward_y * self.speed

        self.vel_x += (target_vel_x - self.vel_x) * self.grip
        self.vel_y += (target_vel_y - self.vel_y) * self.grip

        # Apply friction if no gas is pressed (Player only)
        if self.is_player and not keys[pygame.K_UP] and not keys[pygame.K_DOWN]:
            self.speed *= self.friction
            self.vel_x *= self.friction
            self.vel_y *= self.friction

        # Update Position
        self.x += self.vel_x
        self.y += self.vel_y

        # Screen Wrap
        if self.x > WIDTH: self.x = 0
        if self.x < 0: self.x = WIDTH
        if self.y > HEIGHT: self.y = 0
        if self.y < 0: self.y = HEIGHT

    def draw(self, surface):
        # Add police flashing lights
        if not self.is_player:
            light_color = RED if (pygame.time.get_ticks() % 400 < 200) else BLUE
            pygame.draw.rect(self.original_image, light_color, (2, 5, self.width - 4, 4))

        # Rotate the car image
        # Pygame rotates counter-clockwise for positive angles, so we use -self.angle
        rotated_image = pygame.transform.rotate(self.original_image, -self.angle)
        
        # Get new rect to keep the rotation centered
        new_rect = rotated_image.get_rect(center=(self.x, self.y))
        surface.blit(rotated_image, new_rect.topleft)

def check_collision(car1, car2):
    # Distance between centers
    dx = car1.x - car2.x
    dy = car1.y - car2.y
    distance = math.hypot(dx, dy)
    # If distance is less than roughly the car's diagonal size, it's a hit
    return distance < (car1.width / 2 + car2.width / 2 + 10)

def main():
    # Game Variables
    player = Car(WIDTH // 2, HEIGHT // 2, PLAYER_COLOR, is_player=True)
    police_cars = []
    score = 0
    game_over = False

    # Spawn Timer setup
    SPAWN_POLICE = pygame.USEREVENT + 1
    pygame.time.set_timer(SPAWN_POLICE, 3000) # Spawn every 3 seconds

    running = True
    while running:
        keys = pygame.key.get_pressed()

        # Event Handling
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                running = False
            
            if event.type == SPAWN_POLICE and not game_over:
                # Spawn at edges
                x = 0 if random.random() > 0.5 else WIDTH
                y = random.randint(0, HEIGHT)
                police_cars.append(Car(x, y, POLICE_COLOR, is_player=False))
            
            if event.type == pygame.KEYDOWN and game_over:
                if event.key == pygame.K_SPACE:
                    # Restart Game
                    main()
                    return

        if not game_over:
            # Update
            score += 1
            player.update(keys)
            
            for cop in police_cars:
                cop.update(keys, target=player)
                if check_collision(player, cop):
                    game_over = True

        # Draw
        screen.fill(BG_COLOR)
        
        player.draw(screen)
        for cop in police_cars:
            cop.draw(screen)

        # UI
        score_text = font.render(f"Score: {score // 60}", True, WHITE)
        controls_text = font.render("Arrows: Drive & Drift", True, (189, 195, 199))
        screen.blit(score_text, (20, 20))
        screen.blit(controls_text, (20, 50))

        if game_over:
            # Game Over Overlay
            overlay = pygame.Surface((WIDTH, HEIGHT))
            overlay.set_alpha(180)
            overlay.fill((0, 0, 0))
            screen.blit(overlay, (0, 0))
            
            go_text = large_font.render("GAME OVER!", True, WHITE)
            restart_text = font.render("Press SPACE to Restart", True, WHITE)
            
            screen.blit(go_text, (WIDTH // 2 - go_text.get_width() // 2, HEIGHT // 2 - 40))
            screen.blit(restart_text, (WIDTH // 2 - restart_text.get_width() // 2, HEIGHT // 2 + 20))

        pygame.display.flip()
        clock.tick(FPS)

    pygame.quit()
    sys.exit()

if __name__ == "__main__":
    main()